{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApiGatewayReadAccess",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": [
        "arn:aws:apigateway:*::/apis/*",
        "arn:aws:apigateway:*::/restapis/*",
        "arn:aws:apigateway:*::/domainnames/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DemosFor": "OTEL-DevOpsAgent-AIforOperations"
        }
      }
    },
    {
      "Sid": "CoreServices",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:Get*",
        "ec2:Search*",
        "eks:Describe*",
        "eks:List*",
        "ecr:Describe*",
        "ecr:List*",
        "ecr:Get*",
        "ecs:Describe*",
        "ecs:List*",
        "logs:Describe*",
        "logs:List*",
        "logs:Get*",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:StopQuery",
        "logs:TestMetricFilter",
        "logs:StopLiveTail",
        "cloudwatch:*",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:Get*",
        "lambda:Get*",
        "lambda:List*",
        "iam:Get*",
        "iam:List*",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "dynamodb:Get*",
        "rds:Describe*",
        "rds:List*",
        "elasticloadbalancing:Describe*",
        "elasticloadbalancing:Get*",
        "autoscaling:Describe*",
        "tag:GetResources"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DemosFor": "OTEL-DevOpsAgent-AIforOperations"
        }
      }
    }
  ]
}
