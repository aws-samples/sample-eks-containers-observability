{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApiGatewayReadAccess",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": [
        "arn:aws:apigateway:*::/apis/*",
        "arn:aws:apigateway:*::/restapis/*",
        "arn:aws:apigateway:*::/domainnames/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DemosFor": "OTEL-DevOpsAgent-AIforOperations"
        }
      }
    },
    {
      "Sid": "ReadOnlyAccessCore",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:Get*",
        "ec2:Search*",
        "eks:Describe*",
        "eks:List*",
        "ecr:Describe*",
        "ecr:List*",
        "ecr:Get*",
        "ecs:Describe*",
        "ecs:List*",
        "logs:Describe*",
        "logs:List*",
        "logs:Get*",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:StopQuery",
        "logs:TestMetricFilter",
        "logs:StopLiveTail",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "cloudwatch:GenerateQuery",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:Get*",
        "lambda:Get*",
        "lambda:List*",
        "iam:Get*",
        "iam:List*",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "dynamodb:Get*",
        "rds:Describe*",
        "rds:List*",
        "elasticloadbalancing:Describe*",
        "elasticloadbalancing:Get*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DemosFor": "OTEL-DevOpsAgent-AIforOperations"
        }
      }
    },
    {
      "Sid": "ReadOnlyAccessExtended",
      "Effect": "Allow",
      "Action": [
        "autoscaling:Describe*",
        "sns:Get*",
        "sns:List*",
        "sqs:Get*",
        "sqs:List*",
        "kms:Describe*",
        "kms:List*",
        "kms:Get*",
        "secretsmanager:Describe*",
        "secretsmanager:List*",
        "secretsmanager:Get*",
        "bedrock:Get*",
        "bedrock:List*",
        "aps:Describe*",
        "aps:List*",
        "aps:Get*",
        "grafana:Describe*",
        "grafana:List*",
        "grafana:Get*",
        "cloudtrail:Describe*",
        "cloudtrail:Get*",
        "cloudtrail:List*",
        "cloudtrail:LookupEvents",
        "cloudtrail:StartQuery",
        "s3:Get*",
        "s3:List*",
        "tag:GetResources",
        "resource-groups:Get*",
        "resource-groups:List*",
        "resource-explorer-2:Get*",
        "resource-explorer-2:List*",
        "xray:Get*",
        "xray:List*",
        "xray:BatchGetTraces",
        "states:Describe*",
        "states:List*",
        "states:Get*",
        "batch:Describe*",
        "batch:List*",
        "kinesis:Describe*",
        "kinesis:List*",
        "kinesis:Get*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DemosFor": "OTEL-DevOpsAgent-AIforOperations"
        }
      }
    },
    {
      "Sid": "ReadOnlyAccessAdditional",
      "Effect": "Allow",
      "Action": [
        "kinesisanalytics:Describe*",
        "kinesisanalytics:List*",
        "kinesisvideo:Describe*",
        "firehose:Describe*",
        "firehose:List*",
        "events:Describe*",
        "events:List*",
        "ssm:Describe*",
        "ssm:List*",
        "ssm:Get*",
        "ssm-contacts:Get*",
        "ssm-contacts:List*",
        "ssm-incidents:Get*",
        "ssm-incidents:List*",
        "ssm-sap:Get*",
        "ssm-sap:List*",
        "organizations:Describe*",
        "organizations:List*",
        "config:Describe*",
        "config:List*",
        "config:Get*",
        "backup:Describe*",
        "backup:List*",
        "backup:Get*",
        "backup-gateway:Get*",
        "backup-gateway:List*",
        "elasticache:Describe*",
        "elasticache:List*",
        "elasticmapreduce:Describe*",
        "elasticmapreduce:List*",
        "redshift:Describe*",
        "redshift-serverless:Get*",
        "redshift-serverless:List*",
        "elasticbeanstalk:Describe*",
        "elasticbeanstalk:List*",
        "elasticfilesystem:Describe*",
        "fsx:Describe*",
        "kafka:Describe*",
        "kafka:List*",
        "kafka:Get*",
        "kafkaconnect:Describe*",
        "kafkaconnect:List*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DemosFor": "OTEL-DevOpsAgent-AIforOperations"
        }
      }
    },
    {
      "Sid": "ReadOnlyAccessMonitoring",
      "Effect": "Allow",
      "Action": [
        "application-autoscaling:Describe*",
        "application-signals:Get*",
        "application-signals:List*",
        "application-signals:BatchGetServiceLevelObjectiveBudgetReport",
        "applicationinsights:Describe*",
        "applicationinsights:List*",
        "synthetics:Describe*",
        "synthetics:Get*",
        "synthetics:List*",
        "rum:Get*",
        "rum:List*",
        "evidently:Get*",
        "evidently:List*",
        "internetmonitor:Get*",
        "internetmonitor:List*",
        "pi:Get*",
        "pi:List*",
        "ce:Describe*",
        "ce:Get*",
        "ce:List*",
        "budgets:Describe*",
        "budgets:List*",
        "health:DescribeEvents",
        "health:DescribeEventDetails",
        "devops-guru:Describe*",
        "devops-guru:Get*",
        "devops-guru:List*",
        "oam:Get*",
        "oam:List*",
        "access-analyzer:Get*",
        "access-analyzer:List*",
        "guardduty:Get*",
        "guardduty:List*",
        "securityhub:Describe*",
        "securityhub:Get*",
        "securityhub:List*",
        "securityhub:BatchGetAutomationRules",
        "securityhub:BatchGetSecurityControls",
        "detective:Get*",
        "detective:List*",
        "macie2:Get*",
        "macie2:List*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DemosFor": "OTEL-DevOpsAgent-AIforOperations"
        }
      }
    },
    {
      "Sid": "ReadOnlyAccessDevelopment",
      "Effect": "Allow",
      "Action": [
        "codepipeline:Get*",
        "codepipeline:List*",
        "codebuild:List*",
        "codebuild:BatchGetFleets",
        "codedeploy:Get*",
        "codedeploy:List*",
        "codedeploy:BatchGetDeployments",
        "codedeploy:BatchGetDeploymentTargets",
        "codecommit:Get*",
        "codeartifact:Describe*",
        "codeartifact:Get*",
        "codeartifact:List*",
        "codestar-connections:Get*",
        "codestar-connections:List*",
        "codestar-notifications:Describe*",
        "codestar-notifications:List*",
        "codeguru-profiler:Describe*",
        "codeguru-profiler:Get*",
        "codeguru-profiler:List*",
        "codeguru-reviewer:Describe*",
        "codeguru-reviewer:List*",
        "signer:Get*",
        "signer:List*",
        "imagebuilder:Get*",
        "imagebuilder:List*",
        "amplify:Get*",
        "amplify:List*",
        "appsync:Get*",
        "appsync:List*",
        "appconfig:Get*",
        "appconfig:List*",
        "apprunner:Describe*",
        "apprunner:List*",
        "appflow:Describe*",
        "appflow:List*",
        "appstream:Describe*",
        "appstream:List*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DemosFor": "OTEL-DevOpsAgent-AIforOperations"
        }
      }
    },
    {
      "Sid": "ReadOnlyAccessNetworking",
      "Effect": "Allow",
      "Action": [
        "route53:Get*",
        "route53:List*",
        "route53resolver:Get*",
        "route53resolver:List*",
        "route53profiles:Get*",
        "route53profiles:List*",
        "route53-recovery-control-config:Describe*",
        "route53-recovery-control-config:List*",
        "route53-recovery-readiness:Get*",
        "route53-recovery-readiness:List*",
        "cloudfront:Describe*",
        "cloudfront:Get*",
        "cloudfront:List*",
        "globalaccelerator:Describe*",
        "globalaccelerator:List*",
        "networkmanager:Describe*",
        "networkmanager:Get*",
        "networkmanager:List*",
        "network-firewall:Describe*",
        "network-firewall:List*",
        "vpc-lattice:Get*",
        "vpc-lattice:List*",
        "wafv2:Get*",
        "wafv2:List*",
        "shield:Describe*",
        "shield:List*",
        "fms:Get*",
        "fms:List*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DemosFor": "OTEL-DevOpsAgent-AIforOperations"
        }
      }
    },
    {
      "Sid": "ReadOnlyAccessDataAnalytics",
      "Effect": "Allow",
      "Action": [
        "glue:Get*",
        "glue:List*",
        "glue:querySchemaVersionMetadata",
        "athena:Get*",
        "athena:List*",
        "lakeformation:Describe*",
        "lakeformation:Get*",
        "lakeformation:List*",
        "databrew:Describe*",
        "databrew:List*",
        "datapipeline:Describe*",
        "datapipeline:Get*",
        "datapipeline:List*",
        "datasync:Describe*",
        "datasync:List*",
        "dms:Describe*",
        "dms:List*",
        "timestream:Describe*",
        "timestream:List*",
        "osis:Get*",
        "osis:List*",
        "es:Describe*",
        "es:List*",
        "aoss:BatchGetCollection",
        "aoss:BatchGetLifecyclePolicy",
        "aoss:BatchGetVpcEndpoint",
        "aoss:Get*",
        "aoss:List*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DemosFor": "OTEL-DevOpsAgent-AIforOperations"
        }
      }
    },
    {
      "Sid": "ReadOnlyAccessAI",
      "Effect": "Allow",
      "Action": [
        "sagemaker:Describe*",
        "sagemaker:List*",
        "comprehend:Describe*",
        "comprehend:List*",
        "rekognition:Describe*",
        "rekognition:List*",
        "forecast:Describe*",
        "forecast:List*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DemosFor": "OTEL-DevOpsAgent-AIforOperations"
        }
      }
    },
    {
      "Sid": "ReadOnlyAccessOther",
      "Effect": "Allow",
      "Action": [
        "cognito-identity:Describe*",
        "cognito-identity:Get*",
        "cognito-identity:List*",
        "cognito-idp:Describe*",
        "cognito-idp:Get*",
        "cognito-idp:List*",
        "cognito-idp:AdminListGroupsForUser",
        "ses:Describe*",
        "ses:Get*",
        "ses:List*",
        "iot:Describe*",
        "iot:Get*",
        "iot:List*",
        "iotsitewise:Describe*",
        "iotsitewise:List*",
        "iotwireless:Get*",
        "iotwireless:List*",
        "iotanalytics:Describe*",
        "iotanalytics:List*",
        "iotevents:Describe*",
        "iotevents:List*",
        "iotfleethub:Describe*",
        "iotfleethub:List*",
        "connect:Describe*",
        "connect:Get*",
        "connect:List*",
        "chatbot:Describe*",
        "chatbot:Get*",
        "chatbot:List*",
        "qbusiness:Get*",
        "qbusiness:List*",
        "verifiedpermissions:Get*",
        "verifiedpermissions:List*",
        "ram:Get*",
        "ram:List*",
        "servicequotas:Get*",
        "license-manager:Get*",
        "license-manager:List*",
        "sso:Get*",
        "sso:List*",
        "sso-directory:SearchGroups",
        "sso-directory:SearchUsers"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DemosFor": "OTEL-DevOpsAgent-AIforOperations"
        }
      }
    },
    {
      "Sid": "S3AccessForCDKAssets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectAcl",
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::amplify",
        "arn:aws:s3:::cdk--assets--*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ViaAWSService": "amplify.amazonaws.com",
          "aws:PrincipalAccount": "${aws:ResourceAccount}"
        }
      }
    }
  ]
}
